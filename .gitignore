# ...nhưng migration của Prisma BẮT BUỘC phải commit, nếu không clone mới sẽ
# thấy thư mục migration rỗng và `migrate deploy` không tạo được bảng nào.
!packages/db/prisma/migrations/**/*.sql

# Prisma generated client — regenerated by 'prisma generate' (postinstall)
packages/db/generated/
