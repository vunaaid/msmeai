# vSME — biến môi trường mẫu. Copy thành `.env` rồi điền giá trị THẬT.
# ⚠️  Các giá trị secret dưới đây chỉ là MẶC ĐỊNH DEV (khớp docker-compose.yml).
#     Đổi TẤT CẢ secret (DATABASE_URL, AUTH_SECRET, MINIO_*, ONLYOFFICE_JWT_SECRET,
#     LLM_CREDENTIAL_KEY...) trước khi chạy production. KHÔNG commit file .env.
#
# ─── App ────────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000

# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://vsme:vsme_dev_secret@localhost:5432/vsme_dev?schema=public"
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ─── Redis ──────────────────────────────────────────────────────────────────
REDIS_URL="redis://:vsme_redis_secret@localhost:6379"

# ─── NextAuth.js v5 ─────────────────────────────────────────────────────────
AUTH_SECRET="your-nextauth-secret-min-32-chars-change-in-production"
AUTH_URL=http://localhost:3000

# ─── MinIO (File Storage) ───────────────────────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=vsme_minio_admin
MINIO_SECRET_KEY=vsme_minio_secret
MINIO_BUCKET_FILES=vsme-files
MINIO_BUCKET_EXPORTS=vsme-exports
MINIO_BUCKET_TEMP=vsme-temp
# Endpoint MinIO cho OnlyOffice container tải file (presign theo host này)
MINIO_PUBLIC_ENDPOINT=host.docker.internal
MINIO_PUBLIC_PORT=9000

# ─── Whisper (bóc nội dung ghi âm — module Ghi Chép) ────────────────────────
WHISPER_API_URL=http://localhost:8001
WHISPER_LANGUAGE=vi

# ─── OnlyOffice Document Server ─────────────────────────────────────────────
ONLYOFFICE_URL=http://localhost:8082
NEXT_PUBLIC_ONLYOFFICE_URL=http://localhost:8082
ONLYOFFICE_JWT_SECRET=vsme_onlyoffice_jwt_secret
ONLYOFFICE_CALLBACK_BASE=http://host.docker.internal:4000

# ─── SMTP (Email) ───────────────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="vSME <noreply@vsme.local>"

# ─── AI / LLM ───────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key
GOOGLE_AI_API_KEY=your-google-ai-api-key
OLLAMA_HOST=http://localhost:11434
OLLAMA_ENABLED=false
OLLAMA_DEFAULT_MODEL=qwen2.5:14b

# LLM Routing (claude | gemini | ollama)
LLM_PRIMARY_PROVIDER=claude
LLM_FALLBACK_PROVIDER=gemini
LLM_FAST_PROVIDER=gemini
CLAUDE_DEFAULT_MODEL=claude-sonnet-4-6
GEMINI_DEFAULT_MODEL=gemini-2.0-flash

# Skills directory (absolute path or relative to app root)
SKILLS_DIR=/home/novel/vSME/skills

# ─── BullMQ ─────────────────────────────────────────────────────────────────
QUEUE_CONCURRENCY_AI=5
QUEUE_CONCURRENCY_NOTIFICATIONS=10
QUEUE_CONCURRENCY_REPORTS=2
QUEUE_CONCURRENCY_TCT_SYNC=1
QUEUE_CONCURRENCY_EVENTS=20

# ─── TCT eTax ───────────────────────────────────────────────────────────────
TCT_API_URL=https://hoadondientu.gdt.gov.vn
TCT_TAX_CODE=
TCT_USERNAME=
TCT_PASSWORD=

# ─── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=info
